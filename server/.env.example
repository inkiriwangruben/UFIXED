PORT=8080
# Opsional: hanya diperlukan untuk endpoint admin user / script migrasi Firebase
FIREBASE_SERVICE_ACCOUNT_PATH="C:\path\to\firebase-service-account.json"
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_key
# Atau pakai legacy key jika belum punya secret key baru:
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=laporan
CORS_ORIGIN=*
