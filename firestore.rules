rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasCurrentUserProfile() {
      return signedIn() && exists(userDocPath(request.auth.uid));
    }

    function currentRole() {
      return hasCurrentUserProfile()
        ? get(userDocPath(request.auth.uid)).data.role
        : '';
    }

    function isOwnUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isValidRole(role) {
      return role in [
        'pelapor',
        'admin',
        'department-it',
        'tukang',
        'business-office'
      ];
    }

    function validUserProfile(userId) {
      return request.resource.data.uid == userId &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        isValidRole(request.resource.data.role);
    }

    function isAdmin() {
      return currentRole() == 'admin';
    }

    function isDepartmentIT() {
      return currentRole() == 'department-it';
    }

    function isTukang() {
      return currentRole() == 'tukang';
    }

    function isBusinessOffice() {
      return currentRole() == 'business-office';
    }

    function isPelapor() {
      return currentRole() == 'pelapor';
    }

    function immutableReportFieldsUnchanged() {
      return request.resource.data.authorUid == resource.data.authorUid &&
        request.resource.data.authorEmail == resource.data.authorEmail &&
        request.resource.data.author == resource.data.author &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.judul == resource.data.judul &&
        request.resource.data.deskripsi == resource.data.deskripsi &&
        request.resource.data.kategori == resource.data.kategori &&
        request.resource.data.unitTarget == resource.data.unitTarget &&
        photoMetadataUnchanged() &&
        duplicateMetadataUnchanged();
    }

    function validPriority(priority) {
      return priority in ['low', 'medium', 'high', 'critical'];
    }

    function validDuplicateSource(source) {
      return source in [
        'text',
        'image',
        'text+image',
        'title',
        'location',
        'title+location',
        'title+image',
        'location+image',
        'title+location+image'
      ];
    }

    function validPhotoFingerprintMetadata() {
      return !('photoFingerprints' in request.resource.data) ||
        request.resource.data.photoFingerprints is list;
    }

    function validDuplicateMetadata() {
      return request.resource.data.duplicateKey is string &&
        request.resource.data.duplicateKey.size() > 0 &&
        request.resource.data.duplicateTitleKey is string &&
        request.resource.data.duplicateTitleKey.size() > 0 &&
        (
          !('duplicateLocationKey' in request.resource.data) ||
          (
            request.resource.data.duplicateLocationKey is string &&
            request.resource.data.duplicateLocationKey.size() > 0
          )
        ) &&
        request.resource.data.isDuplicate is bool &&
        request.resource.data.duplicateCheckedAt is timestamp &&
        validPhotoFingerprintMetadata() &&
        (
          (
            request.resource.data.isDuplicate == false &&
            !('duplicateOfReportId' in request.resource.data) &&
            !('duplicateSource' in request.resource.data)
          ) ||
          (
            request.resource.data.isDuplicate == true &&
            request.resource.data.duplicateOfReportId is string &&
            request.resource.data.duplicateOfReportId.size() > 0 &&
            (
              !('duplicateSource' in request.resource.data) ||
              (
                request.resource.data.duplicateSource is string &&
                validDuplicateSource(request.resource.data.duplicateSource)
              )
            )
          )
        );
    }

    function photoMetadataUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'photos',
        'photoFingerprints'
      ]);
    }

    function duplicateMetadataUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'duplicateKey',
        'duplicateTitleKey',
        'duplicateLocationKey',
        'isDuplicate',
        'duplicateOfReportId',
        'duplicateCheckedAt',
        'duplicateSource'
      ]);
    }

    function priorityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['priority']);
    }

    function validInitialWorkflow() {
      return request.resource.data.status == 'menunggu' &&
        request.resource.data.workflowStage == 'admin_review' &&
        request.resource.data.workflowState == 'submitted' &&
        !('priority' in request.resource.data) &&
        validDuplicateMetadata() &&
        (
          (request.resource.data.kategori == 'IT' &&
            request.resource.data.unitTarget == 'department-it') ||
          (request.resource.data.kategori == 'Non-IT' &&
            request.resource.data.unitTarget == 'tukang')
        );
    }

    function adminApprove() {
      return resource.data.workflowStage == 'admin_review' &&
        request.resource.data.workflowStage == 'unit_review' &&
        request.resource.data.workflowState == 'admin_approved' &&
        request.resource.data.status == 'diproses' &&
        validPriority(request.resource.data.priority);
    }

    function rejectFromCurrentStage(roleName) {
      return resource.data.workflowStage in [
          'admin_review',
          'unit_review',
          'business_office_review'
        ] &&
        request.resource.data.workflowStage == 'rejected' &&
        request.resource.data.workflowState == 'rejected' &&
        request.resource.data.status == 'ditolak' &&
        request.resource.data.rejectedByRole == roleName &&
        request.resource.data.rejectionReason is string &&
        request.resource.data.rejectionReason.size() > 0;
    }

    function unitApprove(expectedTarget) {
      return resource.data.unitTarget == expectedTarget &&
        resource.data.workflowStage == 'unit_review' &&
        request.resource.data.workflowStage == 'business_office_review' &&
        request.resource.data.workflowState == 'unit_approved' &&
        request.resource.data.status == resource.data.status;
    }

    function boApprove() {
      return resource.data.workflowStage == 'business_office_review' &&
        request.resource.data.workflowStage == 'unit_repair' &&
        request.resource.data.workflowState == 'bo_approved' &&
        request.resource.data.status == resource.data.status;
    }

    function unitStartRepair(expectedTarget) {
      return resource.data.unitTarget == expectedTarget &&
        resource.data.workflowStage == 'unit_repair' &&
        resource.data.workflowState == 'bo_approved' &&
        request.resource.data.workflowStage == 'unit_repair' &&
        request.resource.data.workflowState == 'repairing' &&
        request.resource.data.status == resource.data.status;
    }

    function unitComplete(expectedTarget) {
      return resource.data.unitTarget == expectedTarget &&
        resource.data.workflowStage == 'unit_repair' &&
        resource.data.workflowState == 'repairing' &&
        request.resource.data.workflowStage == 'done' &&
        request.resource.data.workflowState == 'completed' &&
        request.resource.data.status == 'selesai';
    }

    function canReadReport() {
      return isAdmin() ||
        (isPelapor() && resource.data.authorUid == request.auth.uid) ||
        (isDepartmentIT() && resource.data.unitTarget == 'department-it') ||
        (isTukang() && resource.data.unitTarget == 'tukang') ||
        (
          isBusinessOffice() &&
          resource.data.workflowStage in [
            'business_office_review',
            'unit_repair',
            'done'
          ]
        );
    }

    match /users/{userId} {
      allow get: if isOwnUser(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validUserProfile(userId);
      allow delete: if isAdmin();
    }

    match /pelapor_access/{accessId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userUid == request.auth.uid;
      allow create: if signedIn() &&
        (
          isAdmin() ||
          isDepartmentIT() ||
          isTukang() ||
          isBusinessOffice()
        ) &&
        request.resource.data.userUid is string &&
        request.resource.data.reportId is string &&
        request.resource.data.title is string &&
        request.resource.data.description is string &&
        request.resource.data.status is string;
      allow update, delete: if false;
    }

    match /laporan/{reportId} {
      allow read: if signedIn() && canReadReport();

      allow create: if signedIn() &&
        isPelapor() &&
        request.resource.data.authorUid == request.auth.uid &&
        validInitialWorkflow();

      allow update: if signedIn() &&
        immutableReportFieldsUnchanged() &&
        (
          (isAdmin() &&
            (
              adminApprove() ||
              (priorityUnchanged() && rejectFromCurrentStage('admin'))
            )) ||
          (isDepartmentIT() &&
            priorityUnchanged() &&
            (
              unitApprove('department-it') ||
              rejectFromCurrentStage('department-it') ||
              unitStartRepair('department-it') ||
              unitComplete('department-it')
            )) ||
          (isTukang() &&
            priorityUnchanged() &&
            (
              unitApprove('tukang') ||
              rejectFromCurrentStage('tukang') ||
              unitStartRepair('tukang') ||
              unitComplete('tukang')
            )) ||
          (isBusinessOffice() &&
            priorityUnchanged() &&
            (
              boApprove() ||
              rejectFromCurrentStage('business-office')
            ))
        );

      allow delete: if false;
    }

    // Protected subdocument for unit-provided metadata shown to Business Office
    // and the approving unit only.
    // Only Business Office and the approving technician may read this.
    match /laporan/{reportId}/unitApproval/{metaId} {
      allow read: if signedIn() && (
        isBusinessOffice() || resource.data.approvedByUid == request.auth.uid
      );

      allow create: if signedIn() && (
        (isDepartmentIT() && request.resource.data.approvedByUid == request.auth.uid &&
          get(/databases/$(database)/documents/laporan/$(reportId)).data.unitTarget == 'department-it') ||
        (isTukang() && request.resource.data.approvedByUid == request.auth.uid &&
          get(/databases/$(database)/documents/laporan/$(reportId)).data.unitTarget == 'tukang')
      ) &&
        request.resource.data.estimatedWorkText is string &&
        request.resource.data.estimatedWorkText.size() > 0 &&
        request.resource.data.needsPurchase is bool &&
        (
          !request.resource.data.needsPurchase ||
          request.resource.data.estimatedCost is number
        ) &&
        request.resource.data.unitApprovalNote is string &&
        request.resource.data.unitApprovalNote.size() > 0;

      allow update: if signedIn() &&
        resource.data.approvedByUid == request.auth.uid &&
        request.resource.data.approvedByUid == request.auth.uid &&
        request.resource.data.estimatedWorkText is string &&
        request.resource.data.estimatedWorkText.size() > 0 &&
        request.resource.data.needsPurchase is bool &&
        (
          !request.resource.data.needsPurchase ||
          request.resource.data.estimatedCost is number
        ) &&
        request.resource.data.unitApprovalNote is string &&
        request.resource.data.unitApprovalNote.size() > 0;

      allow delete: if false;
    }
  }
}
