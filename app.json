{
  "expo": {
    "name": "UFIXED",
    "slug": "UFIXED",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ufixed",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi memerlukan akses galeri untuk memilih foto kerusakan.",
          "cameraPermission": "Aplikasi memerlukan akses kamera untuk mengambil foto kerusakan."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "EXPO_PUBLIC_FIREBASE_API_KEY": "AIzaSyDRRZ_gSdnuR5NcorvOSZgLm593TSlCZiA",
      "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "ufixed-e7260.firebaseapp.com",
      "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "ufixed-e7260",
      "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "ufixed-e7260.firebasestorage.app",
      "EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "460587960532",
      "EXPO_PUBLIC_FIREBASE_APP_ID": "1:460587960532:web:159737c3dac53b1cfe1341"
    }
  }
}
